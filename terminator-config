[global_config]
[keybindings]
[profiles]
  [[default]]
    audible_bell = True
    background_darkness = 0.24
    cursor_fg_color = "#00ff00"
    cursor_bg_color = "#000000"
    font = Nimbus Mono PS Bold 12
    foreground_color = "#00ff00"
    scrollback_infinite = True
    palette = "#241f31:#cd0000:#00cd00:#cdcd00:#0000ee:#cd00cd:#00cdcd:#e5e5e5:#7f7f7f:#ff0000:#00ff00:#ffff00:#5c5cff:#ff00ff:#00ffff:#ffffff"
    use_system_font = False
    bold_is_bright = True
    title_transmit_fg_color = "#00ff00"
    title_transmit_bg_color = "#000000"
    title_use_system_font = False
    title_font = Nimbus Mono PS Bold 12
[layouts]
  [[default]]
    [[[window0]]]
      type = Window
      parent = ""
    [[[child1]]]
      type = Terminal
      parent = window0
[plugins]
